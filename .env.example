APP_NAME="Operational Hub Carfast"
APP_ENV=local
APP_SECRET_KEY=replace-with-development-only-random-value
INTEGRATION_API_KEY=
DATABASE_URL=postgresql+psycopg://carfast:carfast@localhost:5432/carfast_v2
DOCUMENT_ARCHIVE_ROOT=var/development/documents
DOCUMENT_INVOICE_INBOX_PATH=var/development/documents/inbox
EMAIL_INBOUND_ENABLED=false
EMAIL_OUTBOUND_ENABLED=false
MODULAR_COMPOSER_ENABLED=false
EMAIL_PUBLIC_BASE_URL=http://localhost:8000
EMAIL_STORAGE_ROOT=var/development/email
EMAIL_MAX_ATTACHMENT_BYTES=15000000
EMAIL_INITIAL_ADDRESS=disabled@carfast.local
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_INBOUND_BASIC_USER=
POSTMARK_INBOUND_BASIC_PASSWORD=
VEHICLE_SALE_MEDIA_ROOT=var/development/vehicle-sales
VEHICLE_SALES_PUBLIC_BASE_URL=http://localhost:8000
